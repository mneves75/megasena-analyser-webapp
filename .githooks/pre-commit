#!/bin/sh
#
# Versioned pre-commit hook: staged secret scan + ast-grep + React Doctor.
#
# ACTIVATION (run once per clone; this is intentionally NOT done automatically):
#
#   git config core.hooksPath .githooks
#
# This is the single hook path for the repo. Do not point core.hooksPath at a
# second directory: Git honours only one, so a competing hook dir silently
# disables everything here.
#
# Behavior:
#   - gitleaks: scans only STAGED changes (gitleaks git --staged), no network
#     needed; --redact keeps any matched secret out of the terminal output.
#     Blocks the commit (exit 1) when a secret is detected. Fail-open no-op when
#     gitleaks is not installed, so contributors without the tool can still commit:
#       brew install gitleaks        # macOS
#       # or see https://github.com/gitleaks/gitleaks#installing
#   - react-doctor: scans staged files and blocks on `error` findings only
#     (warnings never block). Executes only the lockfile-installed binary and
#     fails with an install instruction when dependencies are missing.
#   - ast-grep: applies repository structural rules and blocks on any error.

set -eu

run_gitleaks() {
  if ! command -v gitleaks >/dev/null 2>&1; then
    echo "pre-commit: gitleaks not installed; skipping secret scan." >&2
    echo "pre-commit: install it to enable staged secret scanning (https://github.com/gitleaks/gitleaks)." >&2
    return 0
  fi

  if ! gitleaks git --staged --redact; then
    echo "pre-commit: gitleaks found potential secrets in staged changes; commit blocked." >&2
    echo "pre-commit: remove/rotate the secret, or if it is a false positive add a gitleaks allowlist entry." >&2
    return 1
  fi

  return 0
}

run_ast_grep() {
  if [ ! -x "./node_modules/.bin/ast-grep" ]; then
    echo "pre-commit: lockfile-installed ast-grep not found; commit blocked." >&2
    echo "pre-commit: run pnpm install --frozen-lockfile and retry." >&2
    return 1
  fi

  "./node_modules/.bin/ast-grep" scan --config sgconfig.yml
}

# react-doctor hook start
react_doctor_scan_staged_files() {
  if [ ! -x "./node_modules/.bin/react-doctor" ]; then
    printf '%s\n' \
      "react-doctor: lockfile-installed binary not found; commit blocked." \
      "Run pnpm install --frozen-lockfile and retry." >&2
    return 1
  fi

  "./node_modules/.bin/react-doctor" --staged --blocking error
}

run_react_doctor() {
  react_doctor_output=$(mktemp "${TMPDIR:-/tmp}/react-doctor-hook.XXXXXX")
  if react_doctor_scan_staged_files > "$react_doctor_output" 2>&1; then
    rm -f "$react_doctor_output"
    return 0
  fi

  cat "$react_doctor_output" >&2
  rm -f "$react_doctor_output"
  printf '%s\n' \
    "React Doctor failed or found staged errors; commit blocked." \
    "Run bun run doctor --staged --blocking error to inspect and fix." >&2
  return 1
}
# react-doctor hook end

run_gitleaks || exit 1
run_ast_grep || exit 1
run_react_doctor || exit 1

exit 0
