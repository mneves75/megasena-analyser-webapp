# Next.js base URL used by app router data fetching
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Bun API server configuration
API_PORT=3201
# Keep this loopback. Both processes share one container, and INTERNAL_API_SECRET
# is only attached to loopback targets — pointing API_HOST at a container name or
# remote host makes server-side calls fall back to the public rate-limit quota and
# logs security.internal_secret_target_rejected.
API_HOST=localhost

# CORS: comma-separated list of allowed origins (HTTPS required in production)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3002

# Trust proxy forwarding headers only when your ingress overwrites them
TRUST_PROXY_HEADERS=false
# Required when TRUST_PROXY_HEADERS=true and the API socket peer is not loopback.
# Comma-separated exact proxy peer IPs, for example: 172.18.0.10
# TRUSTED_PROXY_IPS=
# Pins the SINGLE header read for the real client IP. Leave unset to consult
# cf-connecting-ip, then x-real-ip, then x-forwarded-for. Set it to the one header
# your own proxy rewrites on every request whenever the origin can be reached
# without going through Cloudflare: any header the edge merely forwards is
# client-controlled, and it becomes the rate-limit key. Example: x-real-ip
# TRUSTED_CLIENT_IP_HEADER=

# Optional shared secret that lets same-host server-side API calls bypass the
# public API rate limit. Minimum 32 characters. Do not expose it to browsers.
# INTERNAL_API_SECRET=

# Audit log retention (days)
AUDIT_RETENTION_DAYS=400

# Structured log retention (days)
LOG_RETENTION_DAYS=30

# Database path (optional, defaults to db/mega-sena.db)
# DATABASE_PATH=./db/mega-sena.db

# LGPD: HMAC secret for IP pseudonymization (minimum 32 characters).
# REQUIRED in production (NODE_ENV=production). Server refuses to start without it.
# Generate with: openssl rand -hex 32
IP_HASH_SECRET=

# Optional read-only Cloudflare lookup for `bun run security:csp:edge`.
# Keep real tokens outside public repositories.
# Optional direct-origin comparison. Use placeholders only; never commit real origin hosts/IPs.
# ORIGIN_BASE_URL=https://origin.example.com
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ZONE_NAME=megasena-analyzer.com.br
# CLOUDFLARE_ZONE_ID=
# Optional Cloudflare Request Trace. Token needs Allow Request Tracer Read.
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_TRACE_URL=https://megasena-analyzer.com.br/
# CLOUDFLARE_TRACE_METHOD=GET
# CLOUDFLARE_TRACE_HEADERS_JSON={"User-Agent":"edge-csp-check"}
# CLOUDFLARE_TRACE_SKIP_RESPONSE=
# CLOUDFLARE_TRACE_SKIP_CHALLENGE=
# The CSP verifier prints a public-safe probable owner such as shared_response_headers.
