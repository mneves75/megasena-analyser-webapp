index 0000000000000000000000000000000000000000..61297b85299c34b9711218d056a7853197b7c522
--- /dev/null
+++ b/lib/assert-safe-tree.js
@@ -0,0 +1,47 @@
+'use strict';
+
+// A character limit alone cannot bound the recursive walkers' call depth.
+// Validate AST input iteratively too: callers can bypass parse() entirely.
+module.exports = ast => {
+  const pending = [{ node: ast, depth: 0 }];
+  const ancestors = new Set();
+  let visited = 0;
+  while (pending.length) {
+    const frame = pending.pop();
+    const { node, depth } = frame;
+    if (frame.leave) {
+      ancestors.delete(node);
+      continue;
+    }
+    if (!node || typeof node !== 'object' || Array.isArray(node)) {
+      throw new TypeError('Expected a syntax tree node');
+    }
+    if (typeof node.type !== 'string' ||
+        (node.value !== undefined && typeof node.value !== 'string') ||
+        ['commas', 'ranges'].some(key => node[key] !== undefined &&
+          (typeof node[key] !== 'number' || !Number.isFinite(node[key])))) {
+      throw new TypeError('Invalid syntax tree scalar');
+    }
+    if (ancestors.has(node)) throw new RangeError('Cyclic syntax tree');
+    // Parser recovery can leave valid parent links outside the returned subtree.
+    // Bound those links without requiring them to match the nodes traversal.
+    const parents = new Set([node]);
+    let parent = node.parent;
+    while (parent) {
+      if (parents.has(parent)) throw new RangeError('Invalid parent reference');
+      if (parents.size > 101) throw new RangeError('Maximum nesting depth (100) exceeded');
+      parents.add(parent);
+      parent = parent.parent;
+    }
+    if (node.nodes && depth > 100) throw new RangeError('Maximum nesting depth (100) exceeded');
+    if (++visited > 20000) throw new RangeError('Maximum syntax tree size exceeded');
+    if (node.nodes) {
+      if (!Array.isArray(node.nodes)) throw new TypeError('Expected an array of syntax tree nodes');
+      ancestors.add(node);
+      pending.push({ node, leave: true });
+      for (let index = node.nodes.length - 1; index >= 0; index--) {
+        pending.push({ node: node.nodes[index], depth: depth + 1 });
+      }
+    }
+  }
+};
