{
  "name": "megasena-analyser",
  "version": "1.7.17",
  "private": true,
  "scripts": {
    "dev": "bun run scripts/dev.ts",
    "dev:next-only": "bun --bun next dev",
    "build": "bun --bun next build && bun run scripts/assert-standalone-clean.ts",
    "dist:standalone": "bun run scripts/sync-standalone-dist.ts",
    "start": "bun run scripts/start-prod.ts",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "test": "vitest",
    "test:e2e": "playwright test",
    "security:secrets": "bun run scripts/scan-secrets.ts",
    "security:secrets:history": "bun run scripts/scan-secret-history.ts",
    "security:csp:edge": "bun run scripts/check-edge-csp.ts",
    "deploy:verify": "bun run scripts/check-production-freshness.ts",
    "db:migrate": "bun run scripts/migrate.ts",
    "db:pull": "bun run scripts/pull-draws.ts",
    "db:export-draws": "bun run scripts/export-draws.ts",
    "audit:prune": "bun run scripts/prune-audit-logs.ts",
    "log:prune": "bun run scripts/prune-log-events.ts"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.462.0",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "recharts": "^3.8.1",
    "server-only": "^0.0.1",
    "tailwind-merge": "^2.6.1",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.5",
    "@playwright/test": "^1.57.0",
    "@tailwindcss/postcss": "^4.1.18",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/bun": "^1.2.23",
    "@types/jsdom": "^27.0.0",
    "@types/node": "^22.18.7",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "6.0.1",
    "@vitest/coverage-v8": "4.1.5",
    "baseline-browser-mapping": "^2.10.9",
    "caniuse-lite": "^1.0.30001792",
    "eslint": "9.36.0",
    "eslint-config-next": "16.2.6",
    "jsdom": "^27.4.0",
    "postcss": "8.5.14",
    "prettier": "^3.8.3",
    "rollup": "4.59.0",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3",
    "vite": "8.0.16",
    "vitest": "4.1.5"
  },
  "engines": {
    "bun": ">=1.3.14",
    "node": ">=22.0.0"
  },
  "runtime": "bun",
  "packageManager": "pnpm@11.13.0",
  "workspaces": [
    "."
  ],
  "overrides": {
    "@babel/core": ">=7.29.1",
    "ajv": "6.14.0",
    "baseline-browser-mapping": "2.10.9",
    "brace-expansion": ">=1.1.13 <2",
    "caniuse-lite": "1.0.30001792",
    "flatted": "3.4.2",
    "js-yaml": ">=4.3.0 <5",
    "minimatch": "3.1.4",
    "picomatch": ">=2.3.2",
    "postcss": ">=8.5.10",
    "rollup": "4.59.0",
    "ws": ">=8.21.0"
  }
}
