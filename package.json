{
  "name": "megasena-analyser",
  "version": "1.18.1",
  "private": true,
  "scripts": {
    "dev": "bun run scripts/dev.ts",
    "dev:next-only": "bun --bun next dev",
    "build": "node node_modules/next/dist/bin/next build && bun run scripts/assert-standalone-clean.ts",
    "dist:standalone": "bun run scripts/sync-standalone-dist.ts",
    "start": "bun run scripts/start-prod.ts",
    "lint": "eslint . --max-warnings=0",
    "lint:ast": "ast-grep scan --config sgconfig.yml",
    "typecheck": "next typegen && tsc --noEmit",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "test": "vitest",
    "test:sqlite": "E2E_DATABASE_PATH=.tmp/e2e/delay-analysis-test.db bun run scripts/prepare-e2e-db.ts && DATABASE_PATH=.tmp/e2e/delay-analysis-test.db VITEST_FORCE_FILE_DB=1 bun --bun node_modules/vitest/vitest.mjs tests/lib/analytics/delay-analysis.test.ts --run",
    "test:e2e": "playwright test",
    "test:argent": "argent flow run qa-generator-mobile-375-pagination --platform chromium",
    "security:secrets": "bun run scripts/scan-secrets.ts",
    "security:secrets:history": "bun run scripts/scan-secret-history.ts",
    "security:braces": "vitest run tests/security/braces.test.ts",
    "security:csp:edge": "bun run scripts/check-edge-csp.ts",
    "deploy:verify": "bun run scripts/check-production-freshness.ts",
    "db:migrate": "bun run scripts/migrate.ts",
    "db:pull": "bun run scripts/pull-draws.ts",
    "db:export-draws": "bun run scripts/export-draws.ts",
    "db:backfill-prizes": "bun run scripts/backfill-prizes.ts",
    "db:import-draws": "bun run scripts/import-draws.ts",
    "seo:indexnow": "bun run scripts/indexnow-submit.ts",
    "audit:prune": "bun run scripts/prune-audit-logs.ts",
    "log:prune": "bun run scripts/prune-log-events.ts",
    "doctor": "./node_modules/.bin/react-doctor",
    "dev:vinext": "vite dev --port 3001",
    "build:vinext": "vite build",
    "start:vinext": "vite preview",
    "build:cloudflare": "cf build --mode staging",
    "build:cloudflare:production": "cf build --mode production",
    "deploy:cloudflare:staging": "cf deploy --mode staging",
    "deploy:cloudflare:production": "cf deploy --mode production",
    "test:cloudflare": "bun run tests/cloudflare/database-runtime.ts && bun run tests/cloudflare/transport-runtime.ts && bun run tests/cloudflare/worker-runtime.ts && bun run tests/cloudflare/retained-data-runtime.ts && bun run tests/cloudflare/database-persistence-runtime.ts && bun run tests/cloudflare/scheduler-runtime.ts"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.462.0",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "tailwind-merge": "^2.6.1",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@ast-grep/cli": "0.51.0",
    "@cloudflare/vite-plugin": "2.0.0-beta.sha-ad79608dd",
    "@cloudflare/workers-types": "5.20261022.1",
    "@eslint/eslintrc": "3.3.7",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@types/bun": "^1.4.3",
    "@types/jsdom": "^27.0.0",
    "@types/node": "^22.18.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vinext/cloudflare": "1.2.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitejs/plugin-rsc": "^0.5.38",
    "@vitest/coverage-v8": "4.1.12",
    "ajv": "8.20.0",
    "baseline-browser-mapping": "2.11.30",
    "caniuse-lite": "^1.0.30001819",
    "cf": "1.0.0-beta.5",
    "esbuild": "0.28.2",
    "eslint": "9.36.0",
    "eslint-config-next": "16.4.2",
    "jsdom": "^27.4.0",
    "miniflare": "5.20260926.0-alpha",
    "postcss": "8.5.31",
    "prettier": "^3.9.10",
    "react-doctor": "^0.9.18",
    "react-server-dom-webpack": "19.3.1",
    "rollup": "4.65.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vinext": "1.3.0",
    "vite": "8.3.5",
    "vitest": "4.1.12"
  },
  "engines": {
    "bun": ">=1.4.2",
    "node": ">=22.0.0 <23.0.0"
  },
  "runtime": "bun",
  "packageManager": "pnpm@11.13.0+sha512.88d94724d8f2e6c186744a5584c6e59ecac869ec7ba15e9cb4cd628e8dc7066820b2481d8ee3b51ea8da323a7378068aa58c556a3720d32b7c20a051d088363a",
  "workspaces": [
    "."
  ],
  "type": "module"
}
